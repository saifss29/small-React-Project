import React from "react";

const HabitItem = ({
  habit,
  onToggleComplete,
  onIncrementStreak,
  onDeleteHabit,
}) => {
  return (
    <div className="flex items-center justify-between bg-slate-900/60 p-3 rounded-xl border border-slate-700/50 transition-all hover:border-slate-600">
      {/* Left side alignment cluster */}
      <div className="flex items-center gap-3">
        <input
          type="checkbox"
          checked={habit.isCompleted}
          onChange={() => onToggleComplete(habit.id)}
          className="w-5 h-5 accent-emerald-500 cursor-pointer rounded border-slate-600 bg-slate-800"
        />
        {/* Dynamic conditional styling based on completion */}
        <span
          className={`font-medium transition-all ${
            habit.isCompleted ? "line-through text-slate-500" : "text-slate-200"
          }`}
        >
          {habit.name}
        </span>
      </div>

      {/* Right side controls cluster */}
      <div className="flex items-center gap-3">
        <span className="text-sm font-semibold bg-slate-800 px-2.5 py-1 rounded-lg text-amber-400 border border-slate-700 shadow-sm">
          🔥 {habit.streak} Days
        </span>
        <button
          onClick={() => onIncrementStreak(habit.id)}
          className="text-xs bg-slate-800 hover:bg-slate-700 active:bg-slate-600 text-slate-300 font-medium px-2 py-1 rounded-md border border-slate-700 transition-colors"
        >
          +1 Day
        </button>
        <button
          onClick={() => onDeleteHabit(habit.id)}
          className="text-xs bg-rose-950/40 hover:bg-rose-900/60 text-rose-400 font-medium px-2 py-1 rounded-md border border-rose-900/50 transition-colors"
        >
          Delete
        </button>
      </div>
    </div>
  );
};

export default HabitItem;




