
//App.jsx//

import React, { useState } from "react";
import TripList from "./componenets/TripList";
import TravelForm from "./componenets/TravelForm";

const App = () => {
  const [trips, setTrips] = useState([]);

  const addTrip = (trip) => {
    setTrips((previousTrips) => {
      return [...previousTrips, trip];
    });
  };

  const toggleTrip = (destination) => {
    setTrips(
      trips.map((trip) => {
        if (trip.destination === destination) {
          return {
            ...trip,
            completed: !trip.completed,
          };
        }

        return trip;
      }),
    );
  };

  const deleteTrip = (destination) => {
    const updateTrip = trips.filter((fly) => {
      return fly.destination !== destination;
    });

    setTrips(updateTrip);
  };

  return (
    <div className="min-h-screen bg-gray-100 px-4 py-10">
      <div className="mx-auto max-w-4xl">
        <h1 className="mb-8 text-center text-4xl font-bold text-gray-800">
          Travel Planner
        </h1>

        <div className="grid gap-8 md:grid-cols-2">
          <TravelForm title="Add a New Trip" addTrip={addTrip} />

          <TripList
            title="My Travel Trips"
            trips={trips}
            toggleTrip={toggleTrip}
            deleteTrip={deleteTrip}
          />
        </div>
      </div>
    </div>
  );
};

export default App;


//TravelForm.jsx//


import React, { useState } from "react";

const TravelForm = ({ title, addTrip }) => {
  const [plan, setPlan] = useState("");
  const [travel, setTravel] = useState("");

  const handleSubmit = (e) => {
    e.preventDefault();

    const trip = {
      destination: plan,
      date: travel,
      completed: false,
    };

    addTrip(trip);

    setPlan("");
    setTravel("");
  };

  return (
    <div className="rounded-xl bg-white p-6 shadow-md">
      <h2 className="mb-5 text-2xl font-semibold text-gray-800">{title}</h2>

      <form onSubmit={handleSubmit} className="space-y-4">
        <input
          type="text"
          placeholder="Destination"
          value={plan}
          onChange={(e) => setPlan(e.target.value)}
          className="w-full rounded-lg border border-gray-300 px-4 py-3 outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-200"
        />

        <input
          type="date"
          value={travel}
          onChange={(e) => setTravel(e.target.value)}
          className="w-full rounded-lg border border-gray-300 px-4 py-3 outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-200"
        />

        <button
          type="submit"
          className="w-full rounded-lg bg-blue-600 px-4 py-3 font-semibold text-white transition hover:bg-blue-700"
        >
          Add a Trip
        </button>
      </form>
    </div>
  );
};

export default TravelForm;


//TravelList.jsx//


import React from "react";
import TripCard from "./TripCard";

const TripList = ({ title, trips, toggleTrip, deleteTrip }) => {
  return (
    <div className="rounded-xl bg-white p-6 shadow-md">
      <div className="mb-5 flex items-center justify-between">
        <h2 className="text-2xl font-semibold text-gray-800">{title}</h2>

        <span className="rounded-full bg-blue-100 px-3 py-1 text-sm font-semibold text-blue-700">
          {trips.length} Trips
        </span>
      </div>

      {trips.length === 0 ? (
        <p className="rounded-lg bg-gray-50 p-6 text-center text-gray-500">
          No Trips Planned
        </p>
      ) : (
        <div className="space-y-4">
          {trips.map((trip) => {
            return (
              <TripCard
                key={trip.destination}
                trip={trip}
                toggleTrip={toggleTrip}
                deleteTrip={deleteTrip}
              />
            );
          })}
        </div>
      )}
    </div>
  );
};

export default TripList;


//TravelCard.jsx//

import React from "react";

const TripCard = ({ trip, toggleTrip, deleteTrip }) => {
  return (
    <div className="rounded-lg border border-gray-200 p-4 transition hover:shadow-sm">
      <div className="mb-4">
        <h3 className="text-xl font-semibold text-gray-800">
          {trip.destination}
        </h3>

        <p className="mt-1 text-sm text-gray-500">Travel Date: {trip.date}</p>

        <p
          className={`mt-2 inline-block rounded-full px-3 py-1 text-sm font-medium ${
            trip.completed
              ? "bg-green-100 text-green-700"
              : "bg-yellow-100 text-yellow-700"
          }`}
        >
          {trip.completed ? "Completed" : "Planned"}
        </p>
      </div>

      <div className="flex gap-2">
        <button
          onClick={() => toggleTrip(trip.destination)}
          className="rounded-lg bg-blue-600 px-3 py-2 text-sm font-medium text-white transition hover:bg-blue-700"
        >
          Toggle Status
        </button>

        <button
          onClick={() => deleteTrip(trip.destination)}
          className="rounded-lg bg-red-600 px-3 py-2 text-sm font-medium text-white transition hover:bg-red-700"
        >
          Delete Trip
        </button>
      </div>
    </div>
  );
};

export default TripCard;



